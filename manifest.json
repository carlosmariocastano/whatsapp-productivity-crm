{
  "manifest_version": 3,
  "name": "WhatsApp Productivity CRM",
  "short_name": "WhatsCRM",
  "version": "0.1.0",
  "description": "Productivity assistant for WhatsApp Web with templates, notes, tasks and follow-ups.",

  "permissions": [
    "storage",
    "sidePanel",
    "notifications",
    "activeTab",
    "tabs"
  ],

  "host_permissions": [
    "https://web.whatsapp.com/*"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "action": {
    "default_title": "WhatsApp Productivity CRM"
  },

  "side_panel": {
    "default_path": "sidepanel.html"
  },

  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
``